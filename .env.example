# Copy to .env and fill in. Empty values fall back to the documented default.

# HTTP port (default 8080)
PORT=
# Public base URL of this deployment, no trailing slash (e.g. http://localhost:8080)
COMMITPOOL_BASE_URL=
# PostgreSQL connection string
DATABASE_URL=

# PayPal REST API base URL (default https://api-m.sandbox.paypal.com; sandbox only)
PAYPAL_BASE_URL=
# PayPal Sandbox app credentials (not required when E2E_FAKE_PAYPAL=1)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal Sandbox webhook id; without it /paypal/webhook answers 503
PAYPAL_WEBHOOK_ID=

# AI provider: bedrock (default) or fake
COMMITPOOL_AI_PROVIDER=
# Required when the provider is bedrock
AWS_REGION=
# Bedrock model or inference profile id (default us.anthropic.claude-sonnet-4-5-20250929-v1:0, Claude Sonnet 4.5)
COMMITPOOL_BEDROCK_MODEL=
# Bedrock model that answers when the main model declines a request (default none: no fallback)
COMMITPOOL_BEDROCK_FALLBACK_MODEL=
# Effort for every Bedrock call: none (default; Sonnet 4.5 takes no effort), low, medium, high, xhigh or max for models that take one
COMMITPOOL_BEDROCK_EFFORT=

# 1 enables the demo endpoint that closes the payment window immediately (default 0)
COMMITPOOL_DEMO_MODE=
# 1 enables PayPal-Mock-Response headers; only valid against a sandbox base URL (default 0)
COMMITPOOL_SANDBOX_MOCKS=
# Minutes a reserved seat is held while the buyer approves the payment (default 30)
COMMITPOOL_SEAT_TTL_MIN=
# 1 runs an in-process fake PayPal server, for end-to-end tests (default 0)
E2E_FAKE_PAYPAL=

# Writes a minute one client address may send, or off (default 120)
COMMITPOOL_RATE_LIMIT=
# Signs the MCP server's confirmation tokens (default: a random key per process)
COMMITPOOL_MCP_SECRET=
# Notifications: log (default, not sent) or ses
COMMITPOOL_MAILER=
# Verified SES sender, required with COMMITPOOL_MAILER=ses, such as CommitPool <hello@example.com>
COMMITPOOL_MAIL_FROM=
