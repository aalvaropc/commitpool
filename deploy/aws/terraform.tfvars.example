# Copy to terraform.tfvars (git-ignored) and adjust. Every value is optional.

# project = "commitpool"
# region  = "us-east-1"

# Full image URI with tag; empty uses <ecr_repository_url>:latest.
# image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/commitpool:v1"

# bedrock_model          = "anthropic.claude-opus-5-5"
# bedrock_fallback_model = "anthropic.claude-opus-4-8"
# bedrock_effort         = "low"
# seat_ttl_min           = 30

# db_instance_class = "db.t4g.micro"
# task_cpu          = 512
# task_memory       = 1024
