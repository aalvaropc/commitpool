#!/bin/bash
set -euo pipefail

dnf install -y docker
systemctl enable --now docker

install -d -m 700 /opt/commitpool

cat > /opt/commitpool/config <<'CONFIG'
REGION=${region}
REPOSITORY=${repository}
DOMAIN=${domain}
PARAMETER_PREFIX=${parameter_prefix}
CONFIG

cat > /opt/commitpool/Caddyfile <<'CADDY'
${domain} {
	encode zstd gzip
	reverse_proxy app:8080
}
CADDY

echo '${deploy_script}' | base64 -d > /opt/commitpool/deploy.sh
chmod 700 /opt/commitpool/deploy.sh
