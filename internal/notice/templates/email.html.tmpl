<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:0;background:#f3f2f7;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{.Preheader}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f3f2f7;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
<tr><td style="padding:0 4px 16px;font-family:Outfit,'Segoe UI',Helvetica,Arial,sans-serif;font-size:19px;font-weight:700;color:#5b21b6;">CommitPool</td></tr>
<tr><td style="background:#ffffff;border-radius:22px;padding:28px;font-family:'Work Sans','Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#18122b;">
<h1 style="margin:0 0 16px;font-family:Outfit,'Segoe UI',Helvetica,Arial,sans-serif;font-size:28px;line-height:1.15;font-weight:800;color:#18122b;">{{.Headline}}</h1>
{{range .Paragraphs}}<p style="margin:0 0 14px;">{{.}}</p>
{{end}}{{if .Quote}}<p style="margin:0 0 14px;padding:12px 16px;background:#f3f2f7;border-radius:14px;color:#18122b;">{{.Quote}}</p>
{{end}}{{if .Facts}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 18px;">
{{range .Facts}}<tr><td style="padding:6px 0;width:72px;vertical-align:top;font-size:13px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#5b5470;">{{.Label}}</td><td style="padding:6px 0;font-weight:600;">{{.Value}}</td></tr>
{{end}}</table>
{{end}}{{with .Action}}<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 18px;"><tr><td style="background:#5b21b6;border-radius:14px;"><a href="{{.URL}}" style="display:inline-block;padding:14px 22px;font-family:'Work Sans','Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;">{{.Label}}</a></td></tr></table>
<p style="margin:0 0 14px;font-size:13px;color:#5b5470;word-break:break-all;">{{.URL}}</p>
{{end}}{{range .After}}<p style="margin:0 0 14px;">{{.}}</p>
{{end}}{{if .Share}}<p style="margin:0 0 14px;padding:12px 16px;background:#f3f2f7;border-radius:14px;color:#18122b;">{{.Share}}</p>
{{end}}</td></tr>
<tr><td style="padding:16px 4px;font-family:'Work Sans','Segoe UI',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#5b5470;"><strong style="color:#18122b;">The class happens, or nobody pays.</strong><br>{{.Why}}</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
